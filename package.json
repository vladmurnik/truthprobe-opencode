{
  "name": "opencode-truthprobe",
  "version": "0.3.1",
  "private": true,
  "description": "Token-logprob confidence for opencode: a one-line first-sentence confidence badge, an answer confidence block and doubtful-sentence highlighting",
  "keywords": [
    "opencode",
    "hallucination",
    "calibration",
    "logprobs",
    "confidence",
    "patch"
  ],
  "license": "MIT",
  "scripts": {
    "test": "bun test test/score.test.ts",
    "test:opencode": "bash scripts/run-opencode-tests.sh",
    "sync:opencode": "bash scripts/vm-sync-sources.sh",
    "build:windows": "bash scripts/build-windows.sh",
    "build:linux": "bash scripts/build-linux.sh",
    "mock": "python3 scripts/mock-openai-logprobs.py 8899",
    "probe": "python3 scripts/probe-logprobs.py"
  },
  "devDependencies": {
    "bun-types": "^1.3.0"
  }
}
