+import { describe, expect, test } from "bun:test"
+import { envScoreOptions, scoreAnswer } from "../src/truthprobe/score"
+import { isDoubtful, LEVEL_BOUNDS, levelOf, LEVEL_ORDER } from "../src/truthprobe/levels"
+import type { TokenLogprob } from "../src/truthprobe/types"
+
+describe("levelOf", () => {
+  test("границы уровней включительные снизу", () => {
+    expect(levelOf(1)).toBe("safe")
+    expect(levelOf(LEVEL_BOUNDS.safe)).toBe("safe")
+    expect(levelOf(0.899)).toBe("likely")
+    expect(levelOf(LEVEL_BOUNDS.likely)).toBe("likely")
+    expect(levelOf(0.7)).toBe("uncertain")
+    expect(levelOf(LEVEL_BOUNDS.uncertain)).toBe("uncertain")
+    expect(levelOf(0.5)).toBe("risky")
+    expect(levelOf(LEVEL_BOUNDS.risky)).toBe("risky")
+    expect(levelOf(0.349)).toBe("unreliable")
+    expect(levelOf(0)).toBe("unreliable")
+  })
+
+  test("нет сигнала — нет уровня, а не «самый плохой»", () => {
+    expect(levelOf(null)).toBeNull()
+    expect(levelOf(undefined)).toBeNull()
+    expect(levelOf(Number.NaN)).toBeNull()
+    expect(levelOf(Number.POSITIVE_INFINITY)).toBeNull()
+  })
+
+  test("уровни идут от надёжного к ненадёжному", () => {
+    expect([...LEVEL_ORDER]).toEqual(["safe", "likely", "uncertain", "risky", "unreliable"])
+  })
+
+  test("подсвечиваются только risky и unreliable", () => {
+    expect(isDoubtful("risky")).toBe(true)
+    expect(isDoubtful("unreliable")).toBe(true)
+    expect(isDoubtful("uncertain")).toBe(false)
+    expect(isDoubtful(null)).toBe(false)
+  })
+})
+
+const tokens = (parts: string[], logprob = -0.01): TokenLogprob[] =>
+  parts.map((token) => ({ token, logprob, top: [0, 1, 2].map((k) => ({ token: `alt${k}`, logprob: logprob - 0.1 * (k + 1) })) }))
+
+describe("scoreAnswer проставляет уровень", () => {
+  test("уровень ответа и предложений согласован со score", () => {
+    const text = "The answer is 42."
+    const result = scoreAnswer(text, tokens(["The", " answer", " is", " 42", "."]))
+    expect(result.status).toBe("ok")
+    expect(result.score).not.toBeNull()
+    expect(result.level).toBe(levelOf(result.score))
+    expect(result.sentences[0]?.level).toBe(levelOf(result.sentences[0]?.score))
+  })
+
+  test("неуверенный токен опускает уровень", () => {
+    const text = "The answer is 42."
+    const result = scoreAnswer(text, [
+      { token: "The", logprob: -0.01 },
+      { token: " answer", logprob: -2.5 },
+      { token: " is", logprob: -0.01 },
+      { token: " 42", logprob: -3.2 },
+      { token: ".", logprob: -0.01 },
+    ])
+    expect(result.level).not.toBe("safe")
+    expect(result.sentences[0]?.level).not.toBe("safe")
+    expect(result.sentences[0]?.level).toBe(levelOf(result.sentences[0]?.score))
+  })
+
+  test("без токенов уровень null, а не unreliable", () => {
+    const result = scoreAnswer("Anything.", [])
+    expect(result.status).toBe("unavailable")
+    expect(result.level).toBeNull()
+  })
+})
+
+describe("envScoreOptions", () => {
+  test("читает пороги из окружения", () => {
+    expect(envScoreOptions({ TRUTHPROBE_RISKY_THRESHOLD: "0.6", TRUTHPROBE_SHAKY_THRESHOLD: "0.2" })).toEqual({
+      riskyThreshold: 0.6,
+      shakyThreshold: 0.2,
+    })
+  })
+
+  test("мусор и значения вне 0..1 игнорируются", () => {
+    expect(envScoreOptions({ TRUTHPROBE_RISKY_THRESHOLD: "abc" })).toEqual({})
+    expect(envScoreOptions({ TRUTHPROBE_RISKY_THRESHOLD: "1.5" })).toEqual({})
+    expect(envScoreOptions({ TRUTHPROBE_RISKY_THRESHOLD: "" })).toEqual({})
+    expect(envScoreOptions({})).toEqual({})
+  })
+})
