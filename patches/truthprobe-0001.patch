diff --git a/packages/core/src/truthprobe/score.ts b/packages/core/src/truthprobe/score.ts
new file mode 100644
index 0000000..c0bd923
--- /dev/null
+++ b/packages/core/src/truthprobe/score.ts
@@ -0,0 +1,201 @@
+/**
+ * TruthProbe — скоринг уверенности по token logprobs.
+ *
+ * Все функции чистые: нет I/O, нет состояния, детерминированный результат.
+ * Это позволяет покрыть всю математику юнит-тестами на записанных фикстурах
+ * и использовать модуль и в ядре OpenCode, и в офлайн-калибровке (T8).
+ */
+
+import { splitSentences, type Sentence } from "./sentences.js";
+import {
+  DEFAULT_SCORE_OPTIONS,
+  type AnswerScore,
+  type ScoreOptions,
+  type SentenceScore,
+  type TokenLogprob,
+} from "./types.js";
+
+const PUNCT_ONLY = /^[\s\p{P}\p{S}]+$/u;
+
+/** Токен несёт смысл: не пробелы, не чистая пунктуация/символы. */
+export function isContentToken(token: string, minChars = 2): boolean {
+  if (!token) return false;
+  if (!/\S/.test(token)) return false;
+  if (PUNCT_ONLY.test(token)) return false;
+  return token.replace(/\s/g, "").length >= minChars;
+}
+
+/**
+ * Нормированная энтропия распределения на первом токене.
+ *
+ * q_i = exp(lp_i) / Σ exp(lp_j) по доступному top-K; H = -Σ q_i ln q_i / ln K.
+ * Если top-K нет (провайдер не вернул) — деградируем к 1 - p(token),
+ * то есть φ = p(token).
+ */
+export function normalizedEntropy(t: TokenLogprob, topK = 20): number {
+  const top = (t.top ?? []).filter((x) => Number.isFinite(x.logprob));
+  if (top.length < 2) return clamp01(1 - Math.exp(t.logprob));
+
+  const probs = top.map((x) => Math.exp(x.logprob));
+  const sum = probs.reduce((a, b) => a + b, 0);
+  if (!(sum > 0)) return 1;
+
+  let h = 0;
+  for (const p of probs) {
+    const q = p / sum;
+    if (q > 0) h -= q * Math.log(q);
+  }
+  const k = Math.max(2, Math.min(topK, top.length));
+  return clamp01(h / Math.log(k));
+}
+
+/** φ = уверенность по первому токену, 0..1. */
+export function phi(t: TokenLogprob, topK = 20): number {
+  return clamp01(1 - normalizedEntropy(t, topK));
+}
+
+function clamp01(x: number): number {
+  if (!Number.isFinite(x)) return 0;
+  return Math.min(1, Math.max(0, x));
+}
+
+interface TokenWithOffset extends TokenLogprob {
+  start: number;
+  end: number;
+}
+
+/** Привязывает токены к символьным смещениям исходного текста. */
+export function tokensWithOffsets(tokens: TokenLogprob[]): TokenWithOffset[] {
+  const out: TokenWithOffset[] = [];
+  let pos = 0;
+  for (const t of tokens) {
+    const len = t.token.length;
+    out.push({ ...t, start: pos, end: pos + len });
+    pos += len;
+  }
+  return out;
+}
+
+function sentenceAt(sentences: Sentence[], pos: number): Sentence | null {
+  for (const s of sentences) {
+    if (pos >= s.start && pos < s.end) return s;
+    if (s.start > pos) break;
+  }
+  return null;
+}
+
+function geometricMean(lps: number[]): number {
+  if (lps.length === 0) return 0;
+  return clamp01(Math.exp(lps.reduce((a, b) => a + b, 0) / lps.length));
+}
+
+/**
+ * Считает уверенность по всему ответу.
+ *
+ * @param text  финальный текст ответа (тот же, чьи токены пришли в `tokens`)
+ * @param tokens logprobs по токенам в порядке генерации
+ */
+export function scoreAnswer(
+  text: string,
+  tokens: TokenLogprob[],
+  options: ScoreOptions = {},
+): AnswerScore {
+  const opt = { ...DEFAULT_SCORE_OPTIONS, ...options };
+
+  if (!tokens.length) {
+    return {
+      status: "unavailable",
+      score: null,
+      risk: null,
+      first: null,
+      sentences: [],
+      flagged: 0,
+      reason: "no logprobs in response",
+    };
+  }
+
+  const withOffsets = tokensWithOffsets(tokens);
+  const sentences = splitSentences(text);
+
+  // Дрейф смещений: если конкатенация токенов не совпала с текстом,
+  // привязка к предложениям ненадёжна — сигнализируем partial.
+  const totalLen = withOffsets.length ? withOffsets[withOffsets.length - 1].end : 0;
+  const offsetDrift = Math.abs(totalLen - text.length) > 2;
+
+  const content = withOffsets.filter(
+    (t) =>
+      isContentToken(t.token, opt.minTokenChars) &&
+      (offsetDrift || sentenceAt(sentences, t.start) !== null),
+  );
+
+  if (!content.length) {
+    return {
+      status: "unavailable",
+      score: null,
+      risk: null,
+      first: null,
+      sentences: [],
+      flagged: 0,
+      reason: "no content tokens",
+    };
+  }
+
+  const firstToken = content[0];
+  const first = {
+    score: phi(firstToken, opt.topK),
+    entropy: normalizedEntropy(firstToken, opt.topK),
+    token: firstToken.token,
+  };
+
+  // Группировка по предложениям (если дрейф — всё в одно «предложение»).
+  const buckets = new Map<number, TokenWithOffset[]>();
+  for (const t of content) {
+    const s = offsetDrift ? null : sentenceAt(sentences, t.start);
+    if (!s) continue;
+    const arr = buckets.get(s.i) ?? [];
+    arr.push(t);
+    buckets.set(s.i, arr);
+  }
+
+  const scored: SentenceScore[] = [];
+  for (const [i, arr] of [...buckets.entries()].sort((a, b) => a[0] - b[0])) {
+    const s = sentences[i];
+    const lps = arr.map((t) => t.logprob);
+    const geo = geometricMean(lps);
+    const startPhi = phi(arr[0], opt.topK);
+    // Один «придуманный» токен важнее общего среднего: именно он выдаёт
+    // сфабрикованную сущность/число, поэтому худший токен получает свой вес.
+    const worst = clamp01(Math.exp(Math.min(...lps)));
+    const score = clamp01(0.4 * geo + 0.3 * worst + 0.3 * startPhi);
+    const risk = clamp01(1 - score);
+    scored.push({
+      i,
+      start: s.start,
+      end: s.end,
+      text: s.text,
+      score,
+      risk,
+      meanLp: Math.exp(lps.reduce((a, b) => a + b, 0) / lps.length),
+      minLp: Math.min(...lps),
+      phi: startPhi,
+      tokens: arr.length,
+      flag: risk >= opt.riskyThreshold,
+    });
+  }
+
+  const globalGeo = geometricMean(content.map((t) => t.logprob));
+  const meanSentence = scored.length
+    ? scored.reduce((a, s) => a + s.score, 0) / scored.length
+    : globalGeo;
+  const score = clamp01(opt.globalWeight * globalGeo + (1 - opt.globalWeight) * meanSentence);
+
+  return {
+    status: offsetDrift ? "partial" : "ok",
+    score,
+    risk: clamp01(1 - score),
+    first,
+    sentences: scored,
+    flagged: scored.filter((s) => s.flag).length,
+    ...(offsetDrift ? { reason: "token/text offset drift" } : {}),
+  };
+}
diff --git a/packages/core/src/truthprobe/sentences.ts b/packages/core/src/truthprobe/sentences.ts
new file mode 100644
index 0000000..dd84e4e
--- /dev/null
+++ b/packages/core/src/truthprobe/sentences.ts
@@ -0,0 +1,133 @@
+/**
+ * TruthProbe — сегментация ответа на предложения.
+ *
+ * Задача не «идеальная лингвистика», а стабильные смещения: токены привязываются
+ * к предложениям по символьным позициям, поэтому сегментатор обязан возвращать
+ * корректные `start`/`end` в исходной строке и не включать блоки кода.
+ */
+
+export interface Sentence {
+  i: number;
+  start: number;
+  end: number;
+  text: string;
+}
+
+const FENCE = /^\s*(```|~~~)/;
+
+/** Диапазоны [start, end) блоков кода, включая сами fences. */
+export function codeRanges(text: string): Array<[number, number]> {
+  const ranges: Array<[number, number]> = [];
+  let offset = 0;
+  let open: number | null = null;
+
+  for (const line of text.split("\n")) {
+    const lineStart = offset;
+    const lineEnd = offset + line.length;
+    if (FENCE.test(line)) {
+      if (open === null) open = lineStart;
+      else {
+        ranges.push([open, lineEnd]);
+        open = null;
+      }
+    }
+    offset = lineEnd + 1; // + "\n"
+  }
+  if (open !== null) ranges.push([open, text.length]); // незакрытый fence (стрим ещё идёт)
+  return ranges;
+}
+
+const TERMINATORS = new Set([".", "!", "?", "…", "。", "！", "？"]);
+const ABBREVIATIONS = new Set([
+  "т", "е", "д", "п", "др", "см", "г", "гг", "в", "вв", "рис", "табл", "стр",
+  "e.g", "i.e", "etc", "vs", "cf", "al", "no", "fig", "approx",
+]);
+
+function isExcluded(ranges: Array<[number, number]>, pos: number): boolean {
+  for (const [a, b] of ranges) if (pos >= a && pos < b) return true;
+  return false;
+}
+
+/** Предыдущее «слово» перед позицией index (для отсечения сокращений). */
+function wordBefore(text: string, index: number): string {
+  let i = index - 1;
+  while (i >= 0 && /[A-Za-zА-Яа-яЁё.]/.test(text[i])) i--;
+  return text.slice(i + 1, index).replace(/^\.+|\.+$/g, "").toLowerCase();
+}
+
+/** Сокращение ли это: проверяем и целое слово, и последний сегмент «т.е.» → «е». */
+function isAbbreviation(text: string, index: number): boolean {
+  const word = wordBefore(text, index);
+  if (ABBREVIATIONS.has(word)) return true;
+  const last = word.split(".").pop() ?? "";
+  return last.length > 0 && ABBREVIATIONS.has(last);
+}
+
+/**
+ * Режет текст на предложения. Границы:
+ *  - терминатор `. ! ? …` + пробел/конец строки;
+ *  - пустая строка (абзац);
+ *  - начало markdown-пункта списка;
+ *  - блоки кода целиком выброшены.
+ */
+export function splitSentences(text: string): Sentence[] {
+  const excluded = codeRanges(text);
+  const out: Sentence[] = [];
+  let start = 0;
+
+  const push = (end: number, nextStart: number) => {
+    let s = start;
+    let e = end;
+    while (s < e && /\s/.test(text[s])) s++;
+    while (e > s && /\s/.test(text[e - 1])) e--;
+    const body = text.slice(s, e);
+    if (body.length > 0 && /\S/.test(body) && !isExcluded(excluded, s)) {
+      out.push({ i: out.length, start: s, end: e, text: body });
+    }
+    start = nextStart;
+  };
+
+  for (let i = 0; i < text.length; i++) {
+    if (isExcluded(excluded, i)) {
+      // перепрыгиваем весь блок кода целиком
+      const range = excluded.find(([a, b]) => i >= a && i < b)!;
+      push(i, range[1]);
+      i = range[1] - 1;
+      continue;
+    }
+
+    const ch = text[i];
+
+    // пустая строка
+    if (ch === "\n") {
+      let j = i + 1;
+      while (j < text.length && (text[j] === " " || text[j] === "\t")) j++;
+      if (j < text.length && text[j] === "\n") {
+        push(i, j);
+        i = j - 1;
+        continue;
+      }
+      continue;
+    }
+
+    if (!TERMINATORS.has(ch)) continue;
+
+    const next = text[i + 1];
+    const prev = text[i - 1];
+    const atEnd = i + 1 >= text.length;
+    const boundaryAfter = atEnd || next === "\n" || /\s/.test(next);
+    if (!boundaryAfter) continue;
+    // «3.14», «v1.2»
+    if (/\d/.test(prev ?? "") && /\d/.test(next ?? "")) continue;
+    // «т.е.», «e.g.»
+    if (isAbbreviation(text, i)) continue;
+
+    let end = i + 1;
+    while (end < text.length && (text[end] === " " || text[end] === "\t")) end++;
+    push(end, end);
+    i = end - 1;
+  }
+
+  push(text.length, text.length);
+  return out;
+}
diff --git a/packages/core/src/truthprobe/types.ts b/packages/core/src/truthprobe/types.ts
new file mode 100644
index 0000000..96e8626
--- /dev/null
+++ b/packages/core/src/truthprobe/types.ts
@@ -0,0 +1,81 @@
+/**
+ * TruthProbe — типы данных.
+ *
+ * Всё, что здесь описано, — контракт между слоем провайдера (который собирает
+ * logprobs из стрима), слоем скоринга (чистые функции) и UI/плагинами.
+ */
+
+/** Один альтернативный токен из `top_logprobs`. */
+export interface TopLogprob {
+  token: string;
+  logprob: number;
+}
+
+/** Один сгенерированный токен с вероятностью (и, опционально, top-K). */
+export interface TokenLogprob {
+  token: string;
+  logprob: number;
+  top?: TopLogprob[];
+}
+
+/** Оценка одного предложения. */
+export interface SentenceScore {
+  /** Порядковый номер предложения в ответе, с нуля. */
+  i: number;
+  /** Смещение начала в исходном тексте (включительно). */
+  start: number;
+  /** Смещение конца (исключительно). */
+  end: number;
+  /** Исходный текст предложения. */
+  text: string;
+  /** 0..1, выше — увереннее. */
+  score: number;
+  /** 1 - score. */
+  risk: number;
+  /** Геометрическое среднее вероятностей содержательных токенов. */
+  meanLp: number;
+  /** Минимальный logprob среди содержательных токенов (худший токен). */
+  minLp: number;
+  /** Уверенность по первому содержательному токену предложения. */
+  phi: number;
+  /** Сколько содержательных токенов попало в предложение. */
+  tokens: number;
+  /** score < 1 - riskyThreshold. */
+  flag: boolean;
+}
+
+/** Итог по всему ответу. */
+export interface AnswerScore {
+  status: "ok" | "partial" | "unavailable";
+  /** 0..1 или null, если сигнала нет. */
+  score: number | null;
+  risk: number | null;
+  /** Уверенность по первому содержательному токену всего ответа. */
+  first: { score: number; entropy: number; token: string } | null;
+  sentences: SentenceScore[];
+  /** Количество предложений с flag = true. */
+  flagged: number;
+  /** Причина недоступности (для UI). */
+  reason?: string;
+}
+
+export interface ScoreOptions {
+  /** Размер top-K, по которому считалась энтропия. */
+  topK?: number;
+  /** Порог риска для подсветки. */
+  riskyThreshold?: number;
+  /** Порог «шатко» (жёлтый), если понадобится третий уровень. */
+  shakyThreshold?: number;
+  /** Минимальная длина содержательного токена, чтобы считать его значимым. */
+  minTokenChars?: number;
+  /** Доля веса whole-answer, отданная глобальному геом. среднему. */
+  globalWeight?: number;
+}
+
+export const DEFAULT_SCORE_OPTIONS: Required<ScoreOptions> = {
+  topK: 20,
+  riskyThreshold: 0.45,
+  shakyThreshold: 0.3,
+  minTokenChars: 2,
+  globalWeight: 0.6,
+};
diff --git a/packages/core/test/truthprobe.test.ts b/packages/core/test/truthprobe.test.ts
new file mode 100755
index 0000000..eed85f3
--- /dev/null
+++ b/packages/core/test/truthprobe.test.ts
@@ -0,0 +1,90 @@
+import { describe, expect, test } from "bun:test"
+import { scoreAnswer, phi, normalizedEntropy } from "../src/truthprobe/score.js"
+import { splitSentences } from "../src/truthprobe/sentences.js"
+import type { TokenLogprob } from "../src/truthprobe/types.js"
+
+const tokens = (values: Array<[string, number]>): TokenLogprob[] =>
+  values.map(([token, logprob]) => ({
+    token,
+    logprob,
+    top: [
+      { token, logprob },
+      { token: " other", logprob: logprob - 1 },
+    ],
+  }))
+
+describe("truthprobe.score", () => {
+  test("sentences are split on terminators and keep code fences out", () => {
+    const parts = splitSentences("Первое предложение. Второе!\n\n```js\nconst a = 1;\n```\nТретье?")
+    expect(parts.map((part) => part.text.trim())).toEqual([
+      "Первое предложение.",
+      "Второе!",
+      "Третье?",
+    ])
+  })
+
+  test("phi is 1 for a single certain alternative and drops with entropy", () => {
+    const certain: TokenLogprob = { token: "да", logprob: 0, top: [{ token: "да", logprob: 0 }] }
+    const split: TokenLogprob = {
+      token: "да",
+      logprob: -0.7,
+      top: [
+        { token: "да", logprob: -0.7 },
+        { token: "нет", logprob: -0.7 },
+      ],
+    }
+    expect(phi(certain)).toBe(1)
+    expect(phi(split)).toBeLessThan(0.2)
+    expect(normalizedEntropy(certain)).toBe(0)
+  })
+
+  test("a confident answer scores above a hesitant one", () => {
+    const text = "Москва — столица России. Население около 13 миллионов человек."
+    const confident = scoreAnswer(text, tokens([
+      ["Москва", -0.01],
+      [" —", -0.02],
+      [" столица", -0.01],
+      [" России", -0.03],
+      [".", -0.05],
+      [" Население", -0.02],
+      [" около", -0.01],
+      [" 13", -0.02],
+      [" миллионов", -0.01],
+      [" человек", -0.02],
+      [".", -0.01],
+    ]))
+    const hesitant = scoreAnswer(text, tokens([
+      ["Москва", -2.4],
+      [" —", -1.9],
+      [" столица", -2.2],
+      [" России", -1.8],
+      [".", -0.4],
+      [" Население", -2.1],
+      [" около", -1.7],
+      [" 13", -2.6],
+      [" миллионов", -1.9],
+      [" человек", -2.0],
+      [".", -0.3],
+    ]))
+    expect(confident.status).not.toBe("unavailable")
+    expect(hesitant.status).not.toBe("unavailable")
+    expect(confident.score!).toBeGreaterThan(hesitant.score!)
+    expect(hesitant.flagged).toBeGreaterThan(0)
+  })
+
+  test("missing tokens degrade to unavailable instead of throwing", () => {
+    const result = scoreAnswer("Любой текст.", [])
+    expect(result.status).toBe("unavailable")
+    expect(result.score).toBeNull()
+    expect(result.reason).toBeTruthy()
+  })
+
+  test("offset drift marks the result partial but still scores", () => {
+    const result = scoreAnswer("Совсем другой текст, который не совпадает.", tokens([
+      ["Что-то", -0.1],
+      [" иное", -0.2],
+    ]))
+    expect(result.status).toBe("partial")
+    expect(result.score).not.toBeNull()
+  })
+})
