+import type { TruthprobeInfo } from "@opencode/client/promise"
+
+/** Процент из числа из схемы: там score бывает number | "Infinity" | "NaN" | null. */
+export const percentOf = (value: unknown) =>
+  typeof value === "number" && Number.isFinite(value) ? `${Math.round(value * 100)}%` : "?"
+
+export interface DoubtfulSentence {
+  readonly index?: number
+  readonly score: string
+  readonly text: string
+}
+
+/**
+ * Спорные предложения для подписи под ответом — ровно те же строки, что печатает
+ * TUI: `! #N 8%: <начало предложения>`. Логика вынесена из компонента, чтобы её
+ * можно было проверить тестом без монтирования интерфейса.
+ */
+export function doubtfulSentences(probe: TruthprobeInfo | undefined): DoubtfulSentence[] {
+  if (!probe || probe.status === "unavailable") return []
+
+  return (probe.sentences ?? [])
+    .filter((item) => item.flag)
+    .map((item) => ({
+      index: typeof item.i === "number" && Number.isFinite(item.i) ? item.i + 1 : undefined,
+      score: percentOf(item.score),
+      text: item.text.length > 96 ? `${item.text.slice(0, 93)}...` : item.text,
+    }))
+}
