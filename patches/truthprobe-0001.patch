From 127e30f79b7622fc064dba01426201ab516f7780 Mon Sep 17 00:00:00 2001
From: vladmurnik <vladmurnik@users.noreply.github.com>
Date: Fri, 20 Nov 2026 20:50:16 +0300
Subject: [PATCH 19/28] test(truthprobe): pin cyrillic, CJK, emoji and arabic
 answers

- core: one test file covering five scripts, offsets, sentence spans and the
  'tokens do not match the text' degradation on non-latin input
- the behaviour was already correct; the test exists so a future alignment
  change cannot silently break it
---
 packages/core/test/truthprobe-unicode.test.ts | 87 +++++++++++++++++++
 1 file changed, 87 insertions(+)
 create mode 100644 packages/core/test/truthprobe-unicode.test.ts

diff --git a/packages/core/test/truthprobe-unicode.test.ts b/packages/core/test/truthprobe-unicode.test.ts
new file mode 100644
index 0000000..92b6302
--- /dev/null
+++ b/packages/core/test/truthprobe-unicode.test.ts
@@ -0,0 +1,87 @@
+import { describe, expect, test } from "bun:test"
+
+import { scoreAnswer, tokensWithOffsets } from "../src/truthprobe/score"
+import { splitSentences } from "../src/truthprobe/sentences"
+import type { TokenLogprob } from "../src/truthprobe/types"
+
+/**
+ * Кириллица, CJK, эмодзи, арабский и combining-знаки — это не экзотика:
+ * модели отвечают на всех этих языках. Тест фиксирует, что токенизация по
+ * кодовым единицам не ломает выравнивание и оценку, и что «нет сигнала»
+ * не подменяется выдуманным числом.
+ */
+const cut = (text: string, size: number): TokenLogprob[] => {
+  const out: TokenLogprob[] = []
+  for (let i = 0; i < text.length; i += size) {
+    const token = text.slice(i, i + size)
+    out.push({
+      token,
+      logprob: -0.05,
+      top: [
+        { token, logprob: -0.05 },
+        { token: "\u0000a", logprob: -2.5 },
+        { token: "\u0000b", logprob: -3.5 },
+      ],
+    })
+  }
+  return out
+}
+
+const cases: Array<[string, string]> = [
+  ["кириллица", "Москва — столица России. В ней живёт больше десяти миллионов человек."],
+  ["CJK", "北京是中国的首都。它有一千多万人口。"],
+  ["эмодзи", "Paris is the capital of France 🇫🇷. It has about two million people."],
+  ["арабский", "القاهرة هي عاصمة مصر. يعيش فيها أكثر من عشرة ملايين نسمة."],
+  ["combining", "Zürich liegt in der Schweiz. Die Stadt hat rund 400 000 Einwohner."],
+]
+
+describe("scoreAnswer на нелатинском тексте", () => {
+  for (const [name, text] of cases) {
+    test(`${name}: токены покрывают текст и оценка считается`, () => {
+      const tokens = cut(text, 3)
+      expect(tokens.map((t) => t.token).join("")).toBe(text)
+
+      const offsets = tokensWithOffsets(tokens)
+      expect(offsets[offsets.length - 1]!.end).toBe(text.length)
+
+      const res = scoreAnswer(text, tokens, {})
+      expect(res.status).toBe("ok")
+      expect(res.score).not.toBeNull()
+      expect(res.score!).toBeGreaterThan(0)
+      expect(res.score!).toBeLessThanOrEqual(1)
+      expect(res.risk!).toBeCloseTo(1 - res.score!, 10)
+      expect(res.sentences.length).toBeGreaterThan(0)
+      for (const sentence of res.sentences) {
+        expect(sentence.tokens).toBeGreaterThan(0)
+        expect(text.slice(sentence.start, sentence.end)).toBe(sentence.text)
+      }
+    })
+  }
+
+  test("сумма оценок предложений покрывает весь текст без дыр", () => {
+    for (const [, text] of cases) {
+      const res = scoreAnswer(text, cut(text, 3), {})
+      const covered = res.sentences.reduce((sum, s) => sum + (s.end - s.start), 0)
+      expect(covered).toBeGreaterThan(0)
+      expect(covered).toBeLessThanOrEqual(text.length)
+      const last = res.sentences[res.sentences.length - 1]!
+      expect(last.end).toBe(text.length)
+    }
+  })
+
+  test("CJK режется на предложения по 。", () => {
+    expect(splitSentences("北京是中国的首都。它有一千多万人口。").map((s) => s.text)).toEqual([
+      "北京是中国的首都。",
+      "它有一千多万人口。",
+    ])
+  })
+
+  test("чужие токены — unavailable, а не выдуманное число", () => {
+    const text = "北京是中国的首都。"
+    const wrong = cut("The quick brown fox jumps over the lazy dog.", 3)
+    const res = scoreAnswer(text, wrong, {})
+    expect(res.status).toBe("unavailable")
+    expect(res.score).toBeNull()
+    expect(res.level).toBeNull()
+  })
+})
