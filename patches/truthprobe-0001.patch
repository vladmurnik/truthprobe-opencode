+export * as Truthprobe from "./truthprobe.js"
+
+import { Schema } from "effect"
+import { optional } from "./schema.js"
+
+/**
+ * TruthProbe: уверенность модели по token logprobs.
+ *
+ * Схема намеренно совпадает с внутренним типом скоринга (packages/core/src/truthprobe),
+ * чтобы результат scoreAnswer() уходил в событие без преобразований.
+ */
+export interface First extends Schema.Schema.Type<typeof First> {}
+export const First = Schema.Struct({
+  /** Уверенность по первому содержательному токену ответа, 0..1. */
+  score: Schema.Number,
+  /** Нормированная энтропия top-K первого токена, 0..1. */
+  entropy: Schema.Number,
+  token: Schema.String,
+}).annotate({ identifier: "Truthprobe.First" })
+
+export interface Sentence extends Schema.Schema.Type<typeof Sentence> {}
+export const Sentence = Schema.Struct({
+  /** Порядковый номер предложения, с нуля. */
+  i: Schema.Number,
+  /** Смещение начала в тексте ответа. */
+  start: Schema.Number,
+  /** Смещение конца (исключительно). */
+  end: Schema.Number,
+  text: Schema.String,
+  /** 0..1, выше — увереннее. */
+  score: Schema.Number,
+  risk: Schema.Number,
+  meanLp: Schema.Number,
+  minLp: Schema.Number,
+  phi: Schema.Number,
+  tokens: Schema.Number,
+  /** score ниже порога: предложение спорное. */
+  flag: Schema.Boolean,
+}).annotate({ identifier: "Truthprobe.Sentence" })
+
+export interface Info extends Schema.Schema.Type<typeof Info> {}
+export const Info = Schema.Struct({
+  status: Schema.Literals(["ok", "partial", "unavailable"]),
+  score: Schema.NullOr(Schema.Number),
+  risk: Schema.NullOr(Schema.Number),
+  first: Schema.NullOr(First),
+  sentences: Schema.Array(Sentence),
+  flagged: Schema.Number,
+  reason: optional(Schema.String),
+}).annotate({ identifier: "Truthprobe.Info" })
