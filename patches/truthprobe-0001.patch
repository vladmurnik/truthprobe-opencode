+/**
+ * Визуальная часть вердикта TruthProbe: один и тот же язык для веба, desktop и TUI.
+ *
+ * Здесь нет логики скоринга — только представление. Числа приходят из парта
+ * (`truthprobe`), уровни уже посчитаны ядром; если старый парт уровня не нёс,
+ * `levelOfSentence`/`levelOfInfo` восстанавливают его по score.
+ */
+
+import type { TruthprobeInfo } from "@opencode/client/promise"
+import { For, Show } from "solid-js"
+
+import { type ConfidenceLevel, doubtfulSentences, levelOfInfo, percentOf } from "./doubtful"
+
+/** Цвета уровней. Одна палитра на все темы, поэтому заданы литералами. */
+export function toneOf(level?: ConfidenceLevel): string {
+  switch (level) {
+    case "safe":
+      return "#3fbf6f"
+    case "likely":
+      return "#8bc34a"
+    case "uncertain":
+      return "#e0a032"
+    case "risky":
+      return "#e2683c"
+    case "unreliable":
+      return "#d64545"
+    default:
+      return "currentColor"
+  }
+}
+
+function ratio(value: unknown): number {
+  return typeof value === "number" && Number.isFinite(value) ? Math.min(1, Math.max(0, value)) : 0
+}
+
+/**
+ * Тонкая шкала 0..100%. Ширина фиксирована, чтобы строки метаданных не прыгали
+ * при стриминге; заливка красится по уровню.
+ */
+export function ConfidenceMeter(props: { value: unknown; level?: ConfidenceLevel; width?: number }) {
+  return (
+    <span
+      data-slot="confidence-meter"
+      data-level={props.level ?? "unknown"}
+      style={{
+        display: "inline-block",
+        position: "relative",
+        width: `${props.width ?? 56}px`,
+        height: "4px",
+        "border-radius": "999px",
+        background: "currentColor",
+        opacity: 0.9,
+        "vertical-align": "middle",
+        overflow: "hidden",
+        "margin-inline": "6px",
+      }}
+    >
+      <span
+        style={{
+          position: "absolute",
+          top: "0",
+          bottom: "0",
+          left: "0",
+          width: `${Math.round(ratio(props.value) * 100)}%`,
+          background: toneOf(props.level),
+          "border-radius": "999px",
+          transition: "width 200ms ease-out",
+        }}
+      />
+      <span
+        style={{
+          position: "absolute",
+          inset: "0",
+          background: "currentColor",
+          opacity: 0.18,
+        }}
+      />
+    </span>
+  )
+}
+
+/**
+ * Строка-вердикт под ответом: точка уровня, процент, название уровня и шкала.
+ * `unavailable` — отдельный чип с причиной, без выдуманных процентов.
+ */
+export function ConfidenceLine(props: { probe?: TruthprobeInfo }) {
+  const level = () => levelOfInfo(props.probe)
+  const score = () => props.probe?.score
+  const available = () => !!props.probe && props.probe.status !== "unavailable"
+
+  return (
+    <Show when={props.probe}>
+      <span data-slot="confidence-line" class="inline-flex items-center gap-1.5">
+        <Show
+          when={available()}
+          fallback={
+            <span
+              data-slot="confidence-unavailable"
+              class="inline-flex items-center gap-1 rounded-full border px-2 py-0.5"
+              style={{
+                "border-color": "color-mix(in oklab, var(--v2-yellow-900) 40%, transparent)",
+                color: "var(--v2-yellow-900)",
+              }}
+              title={props.probe?.reason ?? "provider sent no token probabilities"}
+            >
+              no confidence signal
+            </span>
+          }
+        >
+          <span
+            aria-hidden="true"
+            style={{
+              width: "7px",
+              height: "7px",
+              "border-radius": "999px",
+              display: "inline-block",
+              background: toneOf(level()),
+            }}
+          />
+          <span class="text-v2-text-text-faint">
+            {`confidence ${percentOf(score())}`}
+            {level() ? ` \u00B7 ${level()}` : ""}
+            {props.probe?.status === "partial" ? " \u00B7 partial" : ""}
+          </span>
+          <ConfidenceMeter value={score()} level={level()} />
+        </Show>
+      </span>
+    </Show>
+  )
+}
+
+/**
+ * Спорные предложения: плашка уровня, процент, мини-шкала уверенности и начало
+ * текста. Раньше был только цвет левой границы — на глаз он почти не отличался
+ * от обычного текста, теперь уровень читается и по цвету, и по числу.
+ */
+export function DoubtfulList(props: { probe?: TruthprobeInfo }) {
+  const rows = () => doubtfulSentences(props.probe)
+
+  return (
+    <Show when={rows().length > 0}>
+      <div data-slot="doubtful-list" class="mt-1 flex flex-col gap-1">
+        <For each={rows()}>
+          {(sentence) => (
+            <div
+              data-slot="doubtful-sentence"
+              data-level={sentence.level ?? "unknown"}
+              class="flex items-start gap-2 border-l-2 py-0.5 pl-2 text-[13px] leading-text-compact"
+              style={{
+                "border-left-color": toneOf(sentence.level),
+                "background-color": `color-mix(in oklab, ${toneOf(sentence.level)} 8%, transparent)`,
+              }}
+              title={sentence.text}
+            >
+              <span
+                class="shrink-0 rounded-full px-1.5 py-px text-[11px] font-medium tabular-nums"
+                style={{
+                  color: toneOf(sentence.level),
+                  "background-color": `color-mix(in oklab, ${toneOf(sentence.level)} 14%, transparent)`,
+                }}
+              >
+                {`${sentence.index === undefined ? "" : `#${sentence.index} `}${sentence.score}`}
+                {sentence.level ? ` ${sentence.level}` : ""}
+              </span>
+              <span class="min-w-0 flex-1 text-v2-text-text-faint">{sentence.text}</span>
+            </div>
+          )}
+        </For>
+      </div>
+    </Show>
+  )
+}
