+import { describe, expect, test } from "bun:test"
+
+import { bundleScorer, parseWeightsBundle, scorerFromEnv, weightsFor } from "../src/truthprobe/scorer"
+import type { LinearWeights } from "../src/truthprobe/types"
+
+const strong: LinearWeights = { bias: 6, meanLp: 0, minLp: 0, meanPhi: 6, fracLow: 0 }
+const weak: LinearWeights = { bias: -6, meanLp: 0, minLp: 0, meanPhi: -6, fracLow: 0 }
