+
+describe("parseWeightsBundle", () => {
+  test("плоские веса становятся global, моделей нет", () => {
+    const bundle = parseWeightsBundle({ bias: 1, meanLp: 2, minLp: 3, meanPhi: 4, fracLow: 5 })
+    expect(bundle.global).toEqual({ bias: 1, meanLp: 2, minLp: 3, meanPhi: 4, fracLow: 5 })
+    expect(Object.keys(bundle.models)).toEqual([])
+  })
+
+  test("бандл читается вместе с весами моделей", () => {
+    const bundle = parseWeightsBundle({
+      version: 1,
+      features: ["bias", "meanLp", "minLp", "meanPhi", "fracLow"],
+      global: strong,
+      models: { "freepi/particle": weak },
+    })
+    expect(bundle.global).toEqual(strong)
+    expect(bundle.models["freepi/particle"]).toEqual(weak)
+  })
+
+  test("битая запись модели пропускается, остальные остаются", () => {
+    const bundle = parseWeightsBundle({
+      global: strong,
+      models: { broken: { bias: "nope" }, "freepi/particle": weak },
+    })
+    expect(bundle.models["broken"]).toBeUndefined()
+    expect(bundle.models["freepi/particle"]).toEqual(weak)
+  })
+
+  test("нечисловые общие веса — ошибка, а не тихий ноль", () => {
+    expect(() => parseWeightsBundle({ bias: "x", meanLp: 1, minLp: 1, meanPhi: 1, fracLow: 1 })).toThrow()
+  })
+})
+
+describe("weightsFor", () => {
+  const bundle = parseWeightsBundle({ global: strong, models: { "freepi/particle": weak } })
+
+  test("для известной модели берёт её веса", () => {
+    expect(weightsFor(bundle, "freepi/particle")).toEqual(weak)
+  })
+
+  test("для чужой модели и без модели — global", () => {
+    expect(weightsFor(bundle, "opencode/gpt-5")).toEqual(strong)
+    expect(weightsFor(bundle)).toEqual(strong)
+  })
+})
+
+describe("bundleScorer", () => {
