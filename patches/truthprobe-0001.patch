 export const percentOf = (value: unknown) =>
   typeof value === "number" && Number.isFinite(value) ? `${Math.round(value * 100)}%` : "?"
 
+export type ConfidenceLevel = "safe" | "likely" | "uncertain" | "risky" | "unreliable"
+
 export interface DoubtfulSentence {
   readonly index?: number
   readonly score: string
+  /** Уровень из парта; у ответов до 0.5 его нет. */
+  readonly level?: ConfidenceLevel
   readonly text: string
 }
 
+/** Уровень ответа, если ядро его прислало. */
+export function levelOfInfo(probe: TruthprobeInfo | undefined): ConfidenceLevel | undefined {
+  const level = probe?.level
+  return level === "safe" || level === "likely" || level === "uncertain" || level === "risky" || level === "unreliable"
+    ? level
+    : undefined
+}
+
+/** Уровень предложения с откатом на флаг: старые парты не несут `level`. */
+export function levelOfSentence(item: { level?: unknown; flag?: unknown; score?: unknown }): ConfidenceLevel | undefined {
+  const level = item.level
+  if (level === "safe" || level === "likely" || level === "uncertain" || level === "risky" || level === "unreliable")
+    return level
+  if (typeof item.score === "number" && Number.isFinite(item.score)) {
+    if (item.score >= 0.9) return "safe"
+    if (item.score >= 0.75) return "likely"
+    if (item.score >= 0.55) return "uncertain"
+    if (item.score >= 0.35) return "risky"
+    return "unreliable"
+  }
+  return item.flag ? "risky" : undefined
+}
