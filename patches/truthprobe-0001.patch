+    expect(a).toBeLessThan(b)
+    expect(b).toBeGreaterThan(0.9)
+  })
+
+  test("без модели работает global", () => {
+    expect(scorer.score({ features, text: "ответ" })).toBeCloseTo(scorer.score({ features, text: "ответ", model: "other/model" }))
+  })
+
+  test("оценка остаётся в [0,1]", () => {
+    for (const model of ["freepi/particle", "other/model", undefined]) {
