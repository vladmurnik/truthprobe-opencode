+})
+
+describe("modelFromBody", () => {
+  test("РґРѕСЃС‚Р°С‘С‚ РјРѕРґРµР»СЊ", () => {
+    expect(Capability.modelFromBody('{"model":"gpt-5","messages":[]}')).toBe("gpt-5")
