+import { describe, expect, test } from "bun:test"
+
+import {
+  geometricScorer,
+  linearScorer,
+  parseLinearWeights,
+  scorerFromEnv,
+  featuresOf,
+} from "../src/truthprobe/scorer"
+import { scoreAnswer } from "../src/truthprobe/score"
+import type { Scorer } from "../src/truthprobe/types"
+
+describe("geometricScorer", () => {
+  test("повторяет встроенную формулу 0.4·geo + 0.3·worst + 0.3·phi", () => {
+    const features = featuresOf({ meanLp: Math.log(0.8), minLp: Math.log(0.5), meanPhi: 0.9, lowFraction: 0.2 })
+    const score = geometricScorer().score({ features, text: "" })
+    expect(score).toBeCloseTo(0.4 * 0.8 + 0.3 * 0.5 + 0.3 * 0.9, 10)
+  })
+})
+
+describe("linearScorer", () => {
+  test("считает sigmoid(bias + w·x)", () => {
+    const scorer = linearScorer({ bias: 2, meanLp: 1, minLp: 0, meanPhi: 0, fracLow: 0 })
+    // meanLp = 0 → z = 2 → sigmoid(2) ≈ 0.8808
+    const features = featuresOf({ meanLp: 0, minLp: -3, meanPhi: 0.4, lowFraction: 0.5 })
+    expect(scorer.score({ features, text: "" })).toBeCloseTo(1 / (1 + Math.exp(-2)), 6)
+  })
+
+  test("нечисловой вес не роняет оценку, а откатывает к geometric", () => {
+    const scorer = linearScorer({ bias: Number.NaN, meanLp: 1, minLp: 1, meanPhi: 1, fracLow: 1 })
+    const features = featuresOf({ meanLp: Math.log(0.7), minLp: Math.log(0.4), meanPhi: 0.8, lowFraction: 0.1 })
+    expect(scorer.score({ features, text: "" })).toBeCloseTo(geometricScorer().score({ features, text: "" }), 10)
+  })
+})
+
+describe("parseLinearWeights", () => {
+  test("принимает и обёрнутый, и плоский объект", () => {
+    const flat = { bias: 0.1, meanLp: 1, minLp: 2, meanPhi: 3, fracLow: 4 }
+    expect(parseLinearWeights(flat)).toEqual(flat)
+    expect(parseLinearWeights({ weights: flat })).toEqual(flat)
+  })
+
+  test("отвергает мусор", () => {
+    expect(() => parseLinearWeights(null)).toThrow()
+    expect(() => parseLinearWeights({ bias: "x" })).toThrow()
+  })
+})
+
+describe("scorerFromEnv", () => {
+  test("пусто и geometric — это встроенная формула (null)", () => {
+    expect(scorerFromEnv({})).toBeNull()
+    expect(scorerFromEnv({ TRUTHPROBE_SCORER: "geometric" })).toBeNull()
+  })
+
+  test("linear:<path> загружает веса через переданный reader", () => {
+    const json = JSON.stringify({ weights: { bias: 1, meanLp: 1, minLp: 1, meanPhi: 1, fracLow: 1 } })
+    const scorer = scorerFromEnv({ TRUTHPROBE_SCORER: "linear:/tmp/w.json" }, () => json)
+    expect(scorer?.name).toBe("linear:/tmp/w.json")
+  })
+
+  test("битый файл не ломает запуск: предупреждение и null", () => {
+    const scorer = scorerFromEnv({ TRUTHPROBE_SCORER: "linear:/nope.json" }, () => "not json")
+    expect(scorer).toBeNull()
+  })
+
+  test("неизвестный вид скорера — null", () => {
+    expect(scorerFromEnv({ TRUTHPROBE_SCORER: "http://example" })).toBeNull()
+  })
+})
+
+describe("scoreAnswer со сменным скорером", () => {
+  test("использует переданный скорер для ответа и предложений", () => {
+    const tokens = [
+      { token: "It ", logprob: -0.01 },
+      { token: "is ", logprob: -0.01 },
+      { token: "fine.", logprob: -0.01 },
