# Скопируйте в .env и подставьте свои значения. Файл читается руками/скриптами,
# сам opencode его не подхватывает автоматически.

# Коммит sst/opencode, под который нарезан патч (менять только вместе с патчем).
TRUTHPROBE_BASE=007afb1b0c8a36dff93d7945909d4e976545ba95

# Где развёрнуто пропатченное дерево.
TP_DIR=.worktree/opencode
OPENCODE_REPO=.

# Веса скорера: пусто/geometric — встроенная формула,
# linear:<path> — веса из JSON (плоские или бандл {global, models}).
TRUTHPROBE_SCORER=

# Принудительно включить сбор logprobs (обычно не нужно: решает capability модели).
# OPENCODE_TRUTHPROBE=1

# --- Сбор калибровочных данных ---

# OpenAI-совместимый эндпоинт, отдающий logprobs.
COLLECT_URL=http://127.0.0.1:3001/v1
FREELLMAPI_KEY=
# OPENAI_API_KEY=

# Порт мок-провайдера для `make preview`.
MOCK_PORT=8899

# FreeLLMAPI в Docker (см. docs/FREELLMAPI.md).
# ENCRYPTION_KEY=
# FREEAPI_CONFIG_JSON=
